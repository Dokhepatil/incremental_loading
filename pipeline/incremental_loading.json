{
	"name": "incremental_loading",
	"properties": {
		"activities": [
			{
				"name": "Copy_Customer_Incremental",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_New_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT *\nFROM customer\nWHERE updated_at >\n'@{activity('Lookup_Old_Watermark').output.firstRow.last_updated}'\nAND updated_at <=\n'@{activity('Lookup_New_Watermark').output.firstRow.new_watermark}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "source_db_ds2",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_sql_ds2",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Lookup_Old_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT last_updated\nFROM watermarktracker\nWHERE table_name = 'customer';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "source_db_ds2",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Lookup_New_Watermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup_Old_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT MAX(updated_at) AS new_watermark\nFROM customer;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "source_db_ds2",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "SP_Merge_Customer",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_Customer_Incremental",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_merge_customer]"
				},
				"linkedServiceName": {
					"referenceName": "sink_sql_ls2",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Update_Watermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SP_Merge_Customer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_updatewatermark]",
					"storedProcedureParameters": {
						"last_updated": {
							"value": {
								"value": "@activity('Lookup_New_Watermark').output.firstRow.new_watermark",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"table_name": {
							"value": {
								"value": "@variables('table_name')",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "source_sql_ls2",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"table_name": {
				"type": "String",
				"defaultValue": "customer"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-26T11:00:21Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}